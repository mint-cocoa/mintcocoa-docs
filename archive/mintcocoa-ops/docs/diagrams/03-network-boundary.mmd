C4Deployment
  title MintCocoa Network Boundary and Access Paths

  Deployment_Node(internet, "Internet", "Public network") {
    Person_Ext(externalUser, "External User", "Accesses public services.")
  }

  Deployment_Node(home, "Home LAN", "Operator-side private network") {
    Person(operator, "Operator", "Runs maintenance and validation.")
    Deployment_Node(cpe, "Raspberry Pi IPSec CPE", "strongSwan") {
      Container(ipsec, "OCI Site-to-Site IPSec", "Private tunnel", "Routes operator traffic to OCI private CIDR.")
    }
  }

  Deployment_Node(oci, "OCI VCN", "ap-chuncheon-1 / 10.30.0.0/16") {
    Deployment_Node(publicEdge, "Public edge", "Internet Gateway + public Load Balancer") {
      Container(publicIngress, "public nginx ingress", "Kubernetes Ingress", "Receives public HTTP/TLS traffic.")
    }

    Deployment_Node(oke, "OKE production cluster", "Kubernetes") {
      Container(publicServices, "Public service workloads", "Pods and Services", "docs, dropapp, demo.")
      Container(appPods, "Application pods", "Pods", "Use NAT for outbound dependencies.")
      Container(privateApi, "Private Kubernetes API", "OKE control plane endpoint", "Administrative API kept behind private access.")
      Container(grafana, "Private Grafana ingress", "Internal Load Balancer", "Observability UI for operators.")
    }

    Deployment_Node(privateMgmt, "Management subnet", "Private subnet") {
      Container(gitopsManager, "GitOps manager", "VM + management k3s", "Argo CD control plane.")
    }

    Container(natGateway, "NAT Gateway", "OCI Gateway", "Pod outbound path.")
  }

  System_Ext(registries, "External APIs / registries", "Outbound dependency targets.")

  Rel(externalUser, publicIngress, "Uses public DNS and HTTPS")
  Rel(publicIngress, publicServices, "Routes user traffic")
  Rel(appPods, natGateway, "Outbound traffic")
  Rel(natGateway, registries, "Fetches external dependencies")

  Rel(operator, ipsec, "Routes private management traffic")
  Rel(ipsec, gitopsManager, "Private GitOps access")
  Rel(ipsec, privateApi, "Kubernetes administration")
  Rel(ipsec, grafana, "Private observability access")
